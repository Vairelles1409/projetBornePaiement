<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="univ.etu.projet.projetbornepaiement.controllers.QRTicketController">

    <!-- EN-TÊTE -->
    <top>
        <VBox alignment="CENTER" spacing="10" style="-fx-background-color: #4CAF50; -fx-padding: 20;">
            <Label text="Paiement Validé !" textFill="WHITE">
                <font><Font name="System Bold" size="28.0" /></font>
            </Label>
            <!-- LE SOLDE S'AFFICHERA ICI -->
            <Label fx:id="soldeLabel" text="Solde carte restant : -- €" textFill="WHITE">
                <font><Font size="18.0" /></font>
            </Label>
        </VBox>
    </top>

    <!-- CENTRE -->
    <center>
        <StackPane fx:id="stackPane">

            <!-- LOADER -->
            <ProgressIndicator fx:id="loader" maxHeight="80.0" maxWidth="80.0" />

            <!-- CONTENU PRINCIPAL (Initialement invisible) -->
            <HBox fx:id="mainContent" alignment="CENTER" spacing="50.0" visible="false">
                <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

                <!-- GAUCHE : TICKET DÉTAILLÉ -->
                <VBox alignment="TOP_CENTER" spacing="10" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0); -fx-background-radius: 10;">
                    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

                    <Label text="Détails de la commande" textFill="#555">
                        <font><Font name="System Bold" size="18.0" /></font>
                    </Label>
                    <Region prefHeight="10" />

                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="300.0" prefWidth="320.0" style="-fx-background-color: transparent; -fx-background: white;">
                        <content>
                            <VBox fx:id="ticketBox" spacing="8.0" />
                        </content>
                    </ScrollPane>
                </VBox>

                <!-- DROITE : QR CODE -->
                <VBox alignment="CENTER" spacing="15">
                    <ImageView fx:id="qrImageView" fitHeight="250.0" fitWidth="250.0" pickOnBounds="true" preserveRatio="true" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 0);" />
                    <Label text="Scannez pour conserver" textFill="#777">
                        <font><Font name="System Italic" size="14.0" /></font>
                    </Label>
                </VBox>
            </HBox>
        </StackPane>
    </center>

    <!-- PIED DE PAGE -->
    <bottom>
        <VBox alignment="CENTER" style="-fx-padding: 20;">
            <Button onAction="#closeWindow" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 10 30; -fx-background-radius: 20; -fx-cursor: hand;" text="Terminer et Retour Accueil" />
        </VBox>
    </bottom>

</BorderPane>