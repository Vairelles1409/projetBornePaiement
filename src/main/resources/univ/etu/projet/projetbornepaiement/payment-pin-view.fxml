<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="univ.etu.projet.projetbornepaiement.controllers.PaymentPinController">
    <children>
        <VBox alignment="CENTER" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Label text="Validation du Paiement">
                    <font><Font name="System Bold" size="24.0" /></font>
                </Label>

                <!-- RAPPEL DU MONTANT -->
                <VBox alignment="CENTER" spacing="5">
                    <Label text="Montant de la transaction :" textFill="#757575">
                        <font><Font size="16.0" /></font>
                    </Label>
                    <Label fx:id="amountLabel" text="0.00 €" textFill="#2196f3">
                        <font><Font name="System Bold" size="40.0" /></font>
                    </Label>
                </VBox>

                <Label text="Veuillez saisir votre Code PIN" textFill="#555">
                    <font><Font size="18.0" /></font>
                </Label>

                <!-- Zone d'affichage du PIN (Masqué) -->
                <VBox alignment="CENTER" maxWidth="300.0" prefHeight="80.0" style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 10; -fx-background-radius: 10;">
                    <children>
                        <Label fx:id="pinDisplayLabel" textFill="#333333">
                            <font><Font name="Monospaced Bold" size="48.0" /></font>
                        </Label>
                    </children>
                </VBox>

                <!-- Status de l'opération -->
                <Label fx:id="statusLabel" text="En attente de saisie sur le PinPad..." textFill="ORANGE">
                    <font><Font name="System Italic" size="14.0" /></font>
                </Label>

                <Button onAction="#handleCancel" text="Annuler" textFill="RED" style="-fx-background-color: transparent; -fx-border-color: red; -fx-border-radius: 5; -fx-cursor: hand;"/>
            </children>
        </VBox>
    </children>
</AnchorPane>