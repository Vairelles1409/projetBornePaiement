<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="univ.etu.projet.projetbornepaiement.controllers.EmporterCommande">
    <children>
        <VBox alignment="CENTER" spacing="50.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Label text="Comment souhaitez-vous déguster votre commande ?">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>

                <HBox alignment="CENTER" spacing="40.0">
                    <children>
                        <!-- BOUTON SUR PLACE -->
                        <Button onAction="#handleEatIn" prefHeight="200.0" prefWidth="250.0" text="SUR PLACE" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold; -fx-background-radius: 15;">
                            <!-- Tu pourrais ajouter une icône ici plus tard -->
                        </Button>

                        <!-- BOUTON A EMPORTER -->
                        <Button onAction="#handleTakeAway" prefHeight="200.0" prefWidth="250.0" text="À EMPORTER" style="-fx-background-color: #03A9F4; -fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold; -fx-background-radius: 15;">
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Bouton retour au cas où -->
        <Button onAction="#handleBack" text="Retour au panier" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="30.0" style="-fx-font-size: 16px;"/>
    </children>
</AnchorPane>