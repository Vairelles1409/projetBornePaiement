<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="univ.etu.projet.projetbornepaiement.controllers.MenuController">
    <children>
        <!-- Conteneur Principal : Divise l'écran en 2 -->
        <HBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <!-- PARTIE GAUCHE : LES PRODUITS (On lui donne de l'espace avec HBox.hgrow) -->
                <VBox spacing="10.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #f4f4f4;">
                    <padding>
                        <Insets bottom="10.0" left="20.0" right="10.0" top="20.0" />
                    </padding>
                    <children>
                        <Label text="Carte du Restaurant">
                            <font><Font name="System Bold" size="24.0" /></font>
                        </Label>

                        <!-- SCROLLPANE PRINCIPAL -->
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                            <content>
                                <!-- C'est ici qu'on va empiler les catégories -->
                                <VBox fx:id="menuContainer" spacing="30.0">
                                    <padding>
                                        <Insets bottom="20" left="10" right="10" top="10"/>
                                    </padding>
                                </VBox>
                            </content>
                        </ScrollPane>

                        <Button onAction="#handleBack" text="Retour Accueil" style="-fx-font-size: 14px;" />
                    </children>
                </VBox>

                <!-- PARTIE DROITE : LE MINI PANIER (Largeur fixe ou pourcentage) -->
                <VBox prefWidth="320.0" spacing="10.0" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-width: 0 0 0 1;">
                    <padding>
                        <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
                    </padding>
                    <children>
                        <Label text="Ma Commande" textFill="#333">
                            <font><Font name="System Bold" size="20.0" /></font>
                        </Label>

                        <!-- Liste des items du panier en direct -->
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                            <content>
                                <VBox fx:id="miniCartContainer" spacing="10.0" />
                            </content>
                        </ScrollPane>

                        <!-- Zone Total -->
                        <HBox alignment="CENTER_RIGHT">
                            <Label text="Total: ">
                                <font><Font size="16.0" /></font>
                            </Label>
                            <Label fx:id="miniTotalLabel" text="0.00 €" textFill="#e91e63">
                                <font><Font name="System Bold" size="22.0" /></font>
                            </Label>
                        </HBox>

                        <Button onAction="#handleGoToCart" text="VALIDER MON PANIER" maxWidth="1.7976931348623157E308" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 10;" />
                    </children>
                </VBox>

            </children>
        </HBox>
    </children>
</AnchorPane>